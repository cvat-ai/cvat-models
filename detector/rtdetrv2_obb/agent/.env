CVAT_BASE_URL=https://app.cvat.ai
# Use a distinct project name when running DOTA and DIOR-R deployments in parallel.
COMPOSE_PROJECT_NAME=rtdetrv2-obb
# Leave empty to use "OBB Object Detection - DOTA" or "OBB Object Detection - DIOR-R".
FUNCTION_NAME=""
CVAT_ACCESS_TOKEN=your_cvat_token
# CPU image: cvat/rtdetrv2_obb_agent:latest
# GPU image: cvat/rtdetrv2_obb_agent:latest_GPU
IMAGE_URL=your_repo:your_image_tag
AGENTS_COUNT=1
ORG_SLUG=""
COMPOSE_PROFILES=cpu
FUNCTION_VISIBILITY=private

# Set to a host directory and enable the override below for an explicit local checkpoint.
USER_DATA_ABSOLUTE_PATH=""
#COMPOSE_FILE=docker-compose.yaml:docker-compose-mount-userdata.yaml

# dataset is required and accepts dota or dior-r.
# DOTA single-scale supports N/S/M/L/X; multi-scale supports M/X. DIOR-R supports N/S/M/L/X.
# An explicit checkpoint can be added as: -p checkpoint=str:/app/data/model.pth
MODEL_CONFIG_PARAMS="-p dataset=str:dota -p model_size=str:X -p conf_threshold=float:0.4"
