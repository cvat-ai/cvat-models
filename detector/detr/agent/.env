# Docker compose
# Your CVAT instance URL. Default is https://app.cvat.ai
CVAT_BASE_URL=https://app.cvat.ai
# Name of the function to create in CVAT.
FUNCTION_NAME=your_function_name
# Required to authenticate to CVAT API. You can get it in CVAT UI: https://app.cvat.ai/profile#security
CVAT_ACCESS_TOKEN=your_cvat_token
# Please specify your image url with tag. For example: cvat/rfdetr_agent:latest
# NB! Right now we do not provide RF-DETR agent images. To get the image, please build it yourself using the Dockerfile in this directory.
IMAGE_URL=your_repo:your_image_tag
# Number of agents to deploy.
AGENTS_COUNT=1
# Please specify your org slug if you want agent to deployed for organization
ORG_SLUG=""
# To use GPU, set this to "gpu". Requires Linux + NVIDIA GPU + NVIDIA driver + NVIDIA Container Toolkit + GPU docker image
COMPOSE_PROFILES=cpu
# If you will set this to public, all users of your CVAT instance will be able to see and use the function.
# Otherwise only you and your organization members (if ORG_SLUG is set) will have access to it.
FUNCTION_VISIBILITY=private

# To mount RF-DETR model locally instead of downloading pretrained weights:
# 1. Download or copy the checkpoint into a local directory
# 2. Set USER_DATA_ABSOLUTE_PATH to the directory containing the checkpoint file
# 3. Uncomment COMPOSE_FILE line below
# 4. Set MODEL_CONFIG_PARAMS="-p architecture=str:RFDETRLarge -p model=str:/app/data/checkpoint.pth"
# The checkpoint architecture must match the selected architecture.

USER_DATA_ABSOLUTE_PATH=""
#COMPOSE_FILE=docker-compose.yaml:docker-compose-mount-userdata.yaml

# To annotate video tasks, the agent needs the OpenH264 library (https://github.com/cisco/openh264).
# Set INSTALL_OPENH264=true to download Cisco's OpenH264 library from https://ciscobinary.openh264.org
# when the agent container starts.
# OpenH264 Video Codec provided by Cisco Systems, Inc.
# License: https://www.openh264.org/BINARY_LICENSE.txt

INSTALL_OPENH264=false

# Alternatively, mount your own OpenH264 library:
# 1. Download an OpenH264 2.x library built for Linux and for the CPU architecture of the image
#    (e.g. libopenh264-2.6.0-linux64.8.so for amd64, libopenh264-2.6.0-linux-arm64.8.so for arm64).
#    A macOS or Windows library will not work, even if the host runs macOS or Windows.
# 2. Set OPENH264_LIBRARY_ABSOLUTE_PATH to the path of that file. It must be readable by the user with UID 1000.
# 3. Uncomment COMPOSE_FILE line below. To also mount user data, list all three files:
#    COMPOSE_FILE=docker-compose.yaml:docker-compose-mount-userdata.yaml:docker-compose-mount-openh264.yaml
# Image tasks work without it.

OPENH264_LIBRARY_ABSOLUTE_PATH=""
#COMPOSE_FILE=docker-compose.yaml:docker-compose-mount-openh264.yaml

# Model config params for RF-DETR
# Supported params are: architecture=str:architecture_name, model=str:path_to_checkpoint, keypoint_names_path=str:path_to_keypoint_names
# architecture - required RF-DETR architecture name. Default is RFDETRLarge
# model - optional path to a local checkpoint matching the selected architecture
# keypoint_names_path - only valid for keypoint models and required for custom keypoint checkpoints
# For instance segmentation with RFDETRSegLarge:
# MODEL_CONFIG_PARAMS="-p architecture=str:RFDETRSegLarge"
# For the pretrained RFDETRKeypointPreview model with the default COCO keypoint names:
# MODEL_CONFIG_PARAMS="-p architecture=str:RFDETRKeypointPreview -p keypoint_names_path=str:./keypoints.txt"

MODEL_CONFIG_PARAMS="-p architecture=str:RFDETRLarge"
